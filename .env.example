# TextMosaic environment configuration
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Where CoNLL04 gets cached and where trained checkpoints/logs land during training.
# Consumed starting Session 1 (conll04_loader.py). Relative default keeps a fresh
# `git clone` working on a machine without an N: drive.
TEXTMOSAIC_DATA_DIR=./data

# Explicit CORS allow-list for the FastAPI backend. Never set to "*".
# Consumed starting Session 4 (main.py). Add the real Cloudflare Pages domain once
# it exists — do not invent it here.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Permit only the Host headers served by this backend. The current public Space
# host is included; replace or extend it if the backend domain changes.
ALLOWED_HOSTS=localhost,127.0.0.1,noorrattan-textmosaic.hf.space

# JSON payloads are small by design. The ASGI middleware enforces this for both
# Content-Length and chunked requests before FastAPI reads the complete body.
MAX_REQUEST_BODY_BYTES=16384

# HF Spaces Docker SDK requires the container to listen on 7860. Locked, not a real choice.
# Consumed starting Session 4 (Dockerfile CMD, uvicorn --port).
PORT=7860

# Tier used when a /extract request omits "tier". Must be one of: speed, balanced, accuracy.
# Consumed starting Session 4 (routes.py).
MODEL_TIER_DEFAULT=balanced
